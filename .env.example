# ==============================================================================
# IntelliDocs AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env.local) and customize.
# WARNING: Generate strong random secrets before running in any environment.
# ==============================================================================

# Application Environment & Ports
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
POSTGRES_USER=intellidocs
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=intellidocs_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://intellidocs:replace_with_secure_postgres_password@localhost:5432/intellidocs_db?schema=public

# Redis Cache, Invalidation & Bull Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO S3-Compatible Object Storage
MINIO_ROOT_USER=replace_with_minio_admin_username
MINIO_ROOT_PASSWORD=replace_with_minio_admin_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=intellidocs-documents
MINIO_USE_SSL=false

# ChromaDB Vector Database
CHROMADB_URL=http://localhost:8000
CHROMADB_COLLECTION=intellidocs_embeddings

# Ollama Local LLM & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional Cloud LLM Fallbacks
GROQ_API_KEY=
GROQ_MODEL=llama-3-8b-chat
GOOGLE_API_KEY=

# Authentication & JWT Security (Generate with: openssl rand -base64 48)
JWT_SECRET=replace_with_cryptographically_secure_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_cryptographically_secure_jwt_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Controls & Resource Limits (SEC-05)
MAX_FILE_SIZE=52428800
MAX_MERGE_FILES=20
MAX_TOTAL_PAGES=500
MAX_SPLIT_RANGES=50
MAX_CONVERT_IMAGES=50
ALLOWED_MIME_TYPES=application/pdf

# Logging & Observability
LOG_LEVEL=info
